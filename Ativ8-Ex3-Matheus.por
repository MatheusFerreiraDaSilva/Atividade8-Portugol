programa
{
	
	funcao inicio()
	{ 	//Declaração da entrada de dados
		real salarioinicial, salariofinal

		//Requisitação do salário
		escreva("Qual é o seu sálario atual?\n")
		leia(salarioinicial)

		//Reajuste do salário de 15%
		salariofinal = salarioinicial * 1.15 

		//Exibição do resultado
		escreva("Seu salário final com o reajuste de 15% é de: ", salariofinal)
	}
}


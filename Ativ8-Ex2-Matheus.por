programa
{
	
	funcao inicio()
	{ 	//Declara a entrada de dados
		inteiro num1, num2, quadrado1, quadrado2, resultadofinal

		//Requisitação dos números
		escreva("Escreva o primeiro número:\n")
		leia(num1)

		escreva("Escreva o segundo número:\n")
		leia(num2)

		//Cálculo de quadrados
		quadrado1 = (num1 * num1)
		quadrado2 = (num2 * num2)

		//Cálculo do Resultado Final
		resultadofinal = quadrado1 + quadrado2

		//Exibição do Resultado Final
		escreva("O resultado da soma do quadrados desses dois números é: ", resultadofinal)
	}
}

